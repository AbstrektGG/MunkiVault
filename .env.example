# Postgres connection string
DATABASE_URL=postgres://munki:munki@localhost:5432/munkivault

# 32 random bytes, base64. Generate with: npm run keygen
# Losing this key makes every stored secret unrecoverable. Back it up separately from the database.
MUNKIVAULT_MASTER_KEY=

# Public base URL of the app (used for SSO redirect URIs and secure cookies)
APP_URL=http://localhost:3000

# Session lifetime in hours
SESSION_HOURS=12

# Single sign-on (OpenID Connect). Leave OIDC_ISSUER empty to disable.
# Microsoft Entra ID issuer: https://login.microsoftonline.com/<tenant-id>/v2.0
# Redirect URI to register with the provider: <APP_URL>/api/auth/sso/callback
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_NAME=Single sign-on
# Comma separated email domains allowed to sign in through SSO (empty = any)
OIDC_ALLOWED_DOMAINS=
# Create an account on first SSO sign-in (new accounts get no organization access until granted)
OIDC_AUTO_PROVISION=true
